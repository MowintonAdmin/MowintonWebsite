# ==============================================================================
# Mowinton Consulting — Production Web Server Configuration
# Target Environment: Apache 2.4+ / LiteSpeed Web Server (Hostinger)
# ==============================================================================

# 1. Disable Directory Browsing / Indexing
Options -Indexes

# 2. Block Direct Web Access to Hidden Files & Dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block Sensitive File Formats (configs, databases, dumps, logs, backups, shell scripts, python scripts, markdown docs)
<FilesMatch "(?i)\.(env|sql|log|md|ini|conf|bak|backup|zip|tar|gz|tgz|sh|bat|cmd|py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Strict Folder Restrictions (Internal Logic, DB Schemas, Scripts, Private Uploads)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny direct access to private and internal code directories
    RewriteRule ^(includes|database|scripts|storage|uploads/resumes)(/.*)?$ - [F,L,NC]

    # Route BitBot API requests to proxy controller
    RewriteRule ^api/bitbot(/.*)?$ api/bitbot/index.php [QSA,L]

    # Clean URL Directory Routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ $1/index.php [L]
</IfModule>

# 5. Security & Browser Privacy Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
