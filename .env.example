# Mowinton Consulting — Environment Configuration
# Duplicate this file to .env inside mowinton-website-starter/mowinton-website/ and adjust for your local environment.
# WARNING: NEVER commit .env with real credentials to Git!

APP_ENV=local
APP_URL=http://127.0.0.1:8000

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mowinton_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Administrative & Notification Settings (Optional)
MAIL_TO=admin@mowinton.com
