# Mowinton Consulting — Environment Configuration
# Duplicate this file to .env and adjust values for your local environment.
# WARNING: NEVER commit .env with real credentials to Git!

APP_ENV=local
APP_URL=http://127.0.0.1:8000

# Database Configuration (MySQL / MariaDB)
# Local development default: root (or your local user)
# Production (Hostinger): use a dedicated application database user (least-privilege)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mowinton_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Resume Storage Directory (Optional)
# Default: uploads/resumes (within project root)
# Production recommendation: point outside public_html for defense-in-depth isolation
# RESUME_STORAGE_PATH=../storage/resumes

# Administrative & Notification Settings (Optional)
MAIL_TO=admin@mowinton.com
